// use prisma-8

enum UserRole {
  CUSTOMER
  HOTEL_MANAGER
  ADMIN
}

model User {
  id String @id @onCreate(uuid())
  email String @unique
  name  String
  passwordHash String
  role UserRole @default(CUSTOMER)
  isActive Boolean @default(true)
 createdAt TimestamptzString   @default(now())
  updatedAt TimestamptzString   @onCreate(now()) @onUpdate(now())
}
